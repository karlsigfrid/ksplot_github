lines(diff_true[item_order], type="l", xlab="", ylab="", col=1, lty=1)
lines(est_difficulties[item_order], col=2)
legend("right", legend=c("Estimated difficulty", "True difficulty"),
col=1:2, lty=1:2, inset=get_inset(), bty="n", xpd=TRUE)
title(ylab="Item difficulty", xlab="Items, sorted by difficulty", line=2.2)
