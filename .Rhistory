prep_plot()
plot_grid(c(by(df_items$difficulty_out, df_items$itemID, function(q)q),
by(df_items$difficulty_adjusted, df_items$itemID, function(q)q),
true_values$diff_true[items]),
legend_space=c("Elo estimate", "Adjusted Elo estimate", "True difficulty")
)
for (i in 1:2){
y <- df_items$difficulty_out[df_items$itemID == items[i]]
lines(y, col=i)
y <- df_items$difficulty_adjusted[df_items$itemID == items[i]]
lines(y, col=i, lty=2)
abline(h=diff_true[items[i]], col=i, lty=3)
}
legend("right", inset=get_inset(), xpd = TRUE, bty="n", col="black", lty=1:3,
legend=c("Elo estimate", "Adjusted Elo estimate", "True difficulty"))
title(xlab="Number of responses to the item", ylab="Item difficulty", line=2)
