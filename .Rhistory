library(dplyr)
library(tidyr)
library(elo.glicko)
library(ksplot)
#| echo: false
load("../all_ntrain_models.Robj")
all_models <- all_ntrain_models$train_600
data_train <- all_models$models_random$est_model$data %>%
left_join(all_models$models_random$est_model$items, by="itemID")
load("../true_values.Robj")
diff_true <- true_values$diff_true
theta_true <- true_values$theta_true
#| echo: false
#lookat <- data_train %>%
#  group_by(itemID) %>%
#  summarize(n=n(), diff=difficulty_constant[1]) %>%
#  arrange(desc(diff))
items <- c("q151", "q28", "q75", "q197")
df_items <- data_train %>% filter(itemID %in% items)
#| fig-width: 8
#| fig-height: 5
prep_plot()
plot_grid(c(by(df_items$difficulty_out, df_items$itemID, function(q)q), true_values$diff_true[items]),
legend_space=c("Elo estimated difficulty", "True item difficulty"))
for(i in 1:4){
lines(x=1:sum(data_train$itemID == items[i]),
y=df_items$difficulty_out[df_items$itemID == items[i]],
col=i)
abline(h=true_values$diff_true[items[i]], col=i, lty=2)
}
legend("right", inset=get_inset(), xpd = TRUE, bty="n", col="black", lty=1:2,
legend=c("Elo estimated difficulty", "True item difficulty"))
title(xlab="Number of responses to the item", ylab="Item difficulty", line=2.2)
p <- recordPlot()
save_svg(p, "four_item_difficulties")
save_eps(p, "four_item_difficulties")
#| echo: false
players <- c(116, 223, 316, 528)
#players <- sample(1:600, size=4)
df_players <- data_train %>% filter(respondentID %in% players)
#| fig-width: 8
#| fig-height: 5
prep_plot()
plot_grid(x=rep(1:50, times=8),
y=c(df_players$theta_out, t(true_values$theta_true[players, ])),
legend_space=c("Elo estimated ability", "True ability"))
for(i in 1:4){
lines(x=1:50, y=df_players$theta_out[df_players$respondentID == players[i]],
col=i)
lines(x=1:50, y=theta_true[players[i], ], col=i, lty=2)
}
legend("right", inset=get_inset(), xpd = TRUE, bty="n", col="black", lty=1:2,
legend=c("Elo estimated ability", "True ability"))
title(xlab="Iteration", ylab="Ability", line=2.2)
p <- recordPlot()
save_svg(p, "four_ability_curves")
save_eps(p, "four_ability_curves")
